{
  "name": "@amojs.dev/compiler",
  "version": "0.10.0",
  "type": "module",
  "license": "MIT",
  "description": "AmoJS compiler — parse → IR → codegen (DOM and SSR string targets). Runs on node only; never ships to browsers.",
  "keywords": [
    "amojs",
    "compiler",
    "codegen",
    "signals",
    "template",
    "eject",
    "ssr",
    "ssg"
  ],
  "homepage": "https://amojs.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amojs-dev/amojs.git",
    "directory": "packages/compiler"
  },
  "bugs": "https://github.com/amojs-dev/amojs/issues",
  "author": "Hamidreza Behzadi <hamidbehzadi71@gmail.com>",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./diagnose": {
      "types": "./dist/diagnose.d.ts",
      "default": "./dist/diagnose.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@amojs.dev/core": "workspace:*",
    "acorn": "^8.18.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
