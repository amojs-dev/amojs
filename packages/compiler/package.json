{
  "name": "amojs-compiler",
  "version": "0.6.7-dev",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "AmoJS compiler — parse → IR → codegen. Runs on node only; never ships to browsers.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./diagnose": {
      "types": "./dist/diagnose.d.ts",
      "default": "./dist/diagnose.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "amojs": "workspace:*",
    "acorn": "^8.18.0"
  }
}
