{
  "name": "@amojs.dev/vite",
  "version": "0.9.0",
  "type": "module",
  "license": "MIT",
  "description": "Vite plugin for AmoJS — compiles html`` templates during a normal Vite build, so bundling, tree-shaking and code-splitting are Vite's job.",
  "keywords": [
    "amojs",
    "vite",
    "vite-plugin",
    "compiler",
    "signals",
    "ssr",
    "ssg"
  ],
  "homepage": "https://amojs.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amojs-dev/amojs.git",
    "directory": "packages/vite"
  },
  "bugs": "https://github.com/amojs-dev/amojs/issues",
  "author": "Hamidreza Behzadi <hamidbehzadi71@gmail.com>",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@amojs.dev/compiler": "workspace:*"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "devDependencies": {
    "vite": "^8.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
