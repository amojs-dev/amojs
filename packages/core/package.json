{
  "name": "@amojs.dev/core",
  "version": "0.7.0",
  "type": "module",
  "license": "MIT",
  "description": "AmoJS reactive core — signals, html`` templates, mount. Zero dependencies; runs raw in the browser.",
  "keywords": [
    "reactive",
    "signals",
    "fine-grained",
    "ui",
    "dom",
    "template",
    "no-build",
    "compiler",
    "vanilla",
    "framework"
  ],
  "homepage": "https://amojs.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amojs-dev/amojs.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/amojs-dev/amojs/issues",
  "author": "Hamidreza Behzadi <hamidbehzadi71@gmail.com>",
  "sideEffects": false,
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./runtime": {
      "types": "./types/runtime.d.ts",
      "default": "./src/runtime.js"
    },
    "./compiled": {
      "types": "./types/compiled.d.ts",
      "default": "./src/compiled.js"
    }
  },
  "files": [
    "src",
    "types"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "publishConfig": {
    "access": "public"
  }
}
